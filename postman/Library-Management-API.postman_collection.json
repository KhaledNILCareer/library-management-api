                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Registered user returned\", function () {",
                  "  pm.expect(json).to.have.property(\"user\");",
                  "  pm.expect(json.user).to.have.property(\"_id\");",
                  "  pm.expect(json.user).to.have.property(\"email\");",
                  "});",
                  "",
                  "if (pm.response.code === 201 && json.user?._id) {",
                  "  pm.environment.set(\"userId\", json.user._id);",
                  "}",
                  "",
                  "if (pm.response.code === 201 && json.token) {",
                  "  pm.environment.set(\"memberToken\", json.token);",
                  "}"
                ]
