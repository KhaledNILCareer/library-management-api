        {
          "name": "Create Book",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const isbn = String(Date.now());",
                  "pm.environment.set(\"demoISBN\", isbn);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Response contains created book\", function () {",
                  "  pm.expect(json).to.have.property(\"message\");",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "  pm.expect(json.data).to.have.property(\"_id\");",
                  "  pm.expect(json.data).to.have.property(\"title\");",
                  "  pm.expect(json.data).to.have.property(\"description\");",
                  "  pm.expect(json.data).to.have.property(\"ISBN\");",
                  "  pm.expect(json.data).to.have.property(\"author\");",
                  "  pm.expect(json.data).to.have.property(\"category\");",
                  "  pm.expect(json.data).to.have.property(\"totalCopies\");",
                  "  pm.expect(json.data).to.have.property(\"availableCopies\");",
                  "});",
                  "",
                  "pm.test(\"Copy counts are valid\", function () {",
                  "  pm.expect(json.data.totalCopies).to.be.at.least(0);",
                  "  pm.expect(json.data.availableCopies).to.be.at.least(0);",
                  "  pm.expect(json.data.availableCopies).to.be.at.most(json.data.totalCopies);",
                  "});",
                  "",
                  "if (pm.response.code === 201 && json.data?._id) {",
                  "  pm.environment.set(\"bookId\", json.data._id);",
                  "}"
                ]
              }
            }
          ],
