          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst json = pm.response.json();\r\n\r\npm.test(\"Response contains created book\", function () {\r\n    pm.expect(json).to.have.property(\"message\");\r\n    pm.expect(json).to.have.property(\"data\");\r\n\r\n    pm.expect(json.data).to.have.property(\"_id\");\r\n    pm.expect(json.data).to.have.property(\"title\");\r\n    pm.expect(json.data).to.have.property(\"description\");\r\n    pm.expect(json.data).to.have.property(\"ISBN\");\r\n    pm.expect(json.data).to.have.property(\"author\");\r\n    pm.expect(json.data).to.have.property(\"category\");\r\n    pm.expect(json.data).to.have.property(\"totalCopies\");\r\n    pm.expect(json.data).to.have.property(\"availableCopies\");\r\n});\r\n\r\npm.test(\"Copy counts are valid\", function () {\r\n    pm.expect(json.data.totalCopies).to.be.at.least(0);\r\n    pm.expect(json.data.availableCopies).to.be.at.least(0);\r\n    pm.expect(json.data.availableCopies)\r\n        .to.be.at.most(json.data.totalCopies);\r\n});\r\n\r\nif (json.data?._id) {\r\n    pm.collectionVariables.set(\"bookId\", json.data._id);\r\n}"
                ]
              }
            }
          ],
